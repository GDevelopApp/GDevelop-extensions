        {
          "fullName": "Follow the cursor",
          "functionType": "Action",
          "name": "FollowCursorPosition",
          "sentence": "Move _PARAM0_ to the cursor",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "In the events of the crosshair, the cursor position is relative to the crosshair (its origin is its center)."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BooleanVariable"
                  },
                  "parameters": [
                    "FollowCursor",
                    "True",
                    ""
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "MettreXY"
                  },
                  "parameters": [
                    "Object",
                    "=",
                    "Object.X() + CursorX(\"\", 0) * Object.Scale::X()",
                    "=",
                    "Object.Y() + CursorY(\"\", 0) * Object.Scale::Y()"
                  ]
                }
              ]
            }
          ],
          "parameters": [
            {
              "description": "Object",
              "name": "Object",
              "supplementaryInformation": "Crosshair::Crosshair",
              "type": "object"
            }
