              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "Spread",
                    "=",
                    "max(0, Spread - SpreadRecovery * TimeDelta())"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "MettreXY"
                  },
                  "parameters": [
                    "Arm",
                    "=",
                    "Arm.Variable(BaseX) + Arm.Variable(DirectionX) * Spread",
                    "=",
                    "Arm.Variable(BaseY) + Arm.Variable(DirectionY) * Spread"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
