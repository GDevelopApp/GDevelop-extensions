  "eventsFunctions": [
    {
      "description": "Move and zoom a camera so every instance of the given object or group stays inside the view, with padding, a minimum visible size, and smooth interpolation toward the target.",
      "fullName": "Frame camera on objects",
      "functionType": "Action",
      "name": "FrameCameraOnObjects",
      "sentence": "Frame camera on _PARAM1_ (layer: _PARAM2_, padding: _PARAM3_, min size: _PARAM4_, smoothing: _PARAM5_, zoom: _PARAM6_ to _PARAM7_)",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [
            {
              "type": {
                "value": "NumberVariable"
              },
              "parameters": [
                "DynamicCamera.CurrentZoom",
                "=",
                "0"
              ]
            },
            {
              "type": {
                "value": "BuiltinCommonInstructions::Once"
              },
              "parameters": []
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "DynamicCamera.CurrentZoom",
                "=",
                "1"
              ]
            }
          ]
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Camera zone calculation",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.BoundsMinX",
                    "=",
                    "999999"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.BoundsMaxX",
                    "=",
                    "-999999"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.BoundsMinY",
                    "=",
                    "999999"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.BoundsMaxY",
                    "=",
                    "-999999"
                  ]
                }
              ],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Comment",
                  "color": {
                    "b": 109,
                    "g": 230,
                    "r": 255,
                    "textB": 0,
                    "textG": 0,
                    "textR": 0
                  },
                  "comment": "Enclosing zone"
                },
                {
                  "type": "BuiltinCommonInstructions::ForEach",
                  "object": "Objects",
                  "conditions": [],
                  "actions": [],
                  "events": [
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::CompareNumbers"
                          },
                          "parameters": [
                            "Objects.CenterX() - Objects.Width()/2",
                            "<",
                            "DynamicCamera.BoundsMinX"
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "DynamicCamera.BoundsMinX",
                            "=",
                            "Objects.CenterX() - Objects.Width()/2"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::CompareNumbers"
                          },
                          "parameters": [
                            "Objects.CenterX() + Objects.Width()/2",
                            ">",
                            "DynamicCamera.BoundsMaxX"
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "DynamicCamera.BoundsMaxX",
                            "=",
                            "Objects.CenterX() + Objects.Width()/2"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::CompareNumbers"
                          },
                          "parameters": [
                            "Objects.CenterY() - Objects.Height()/2",
                            "<",
                            "DynamicCamera.BoundsMinY"
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "DynamicCamera.BoundsMinY",
                            "=",
                            "Objects.CenterY() - Objects.Height()/2"
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BuiltinCommonInstructions::Standard",
                      "conditions": [
                        {
                          "type": {
                            "value": "BuiltinCommonInstructions::CompareNumbers"
                          },
                          "parameters": [
                            "Objects.CenterY() + Objects.Height()/2",
                            ">",
                            "DynamicCamera.BoundsMaxY"
                          ]
                        }
                      ],
                      "actions": [
                        {
                          "type": {
                            "value": "SetNumberVariable"
                          },
                          "parameters": [
                            "DynamicCamera.BoundsMaxY",
                            "=",
                            "Objects.CenterY() + Objects.Height()/2"
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Target",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.TargetX",
                    "=",
                    "(DynamicCamera.BoundsMinX + DynamicCamera.BoundsMaxX) / 2"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.TargetY",
                    "=",
                    "(DynamicCamera.BoundsMinY + DynamicCamera.BoundsMaxY) / 2"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.DesiredWidth",
                    "=",
                    "max((DynamicCamera.BoundsMaxX - DynamicCamera.BoundsMinX) + Padding * 2, MinVisibleSize)"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.DesiredHeight",
                    "=",
                    "max((DynamicCamera.BoundsMaxY - DynamicCamera.BoundsMinY) + Padding * 2, MinVisibleSize)"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.BaseWidth",
                    "=",
                    "CameraWidth(Layer)  * DynamicCamera.CurrentZoom"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.BaseHeight",
                    "=",
                    "CameraHeight(Layer) * DynamicCamera.CurrentZoom"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.TargetZoom",
                    "=",
                    "min(DynamicCamera.BaseWidth / DynamicCamera.DesiredWidth,                                  DynamicCamera.BaseHeight / DynamicCamera.DesiredHeight)"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.TargetZoom",
                    "=",
                    "min(max(DynamicCamera.TargetZoom, MinZoom), MaxZoom)"
                  ]
                }
              ]
            }
          ],
          "parameters": []
        },
        {
          "colorB": 228,
          "colorG": 176,
          "colorR": 74,
          "creationTime": 0,
          "name": "Smoothing and application",
          "source": "",
          "type": "BuiltinCommonInstructions::Group",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.CurrentX",
                    "+",
                    "(DynamicCamera.TargetX - DynamicCamera.CurrentX) * Smoothing * TimeDelta()"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.CurrentY",
                    "+",
                    "(DynamicCamera.TargetY - DynamicCamera.CurrentY) * Smoothing * TimeDelta()"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "DynamicCamera.CurrentZoom",
                    "+",
                    "(DynamicCamera.TargetZoom - DynamicCamera.CurrentZoom) * Smoothing * TimeDelta()"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "ZoomCamera"
                  },
                  "parameters": [
                    "",
                    "DynamicCamera.CurrentZoom",
                    "Layer",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "SetCameraCenterX"
                  },
                  "parameters": [
                    "",
                    "=",
                    "DynamicCamera.CurrentX",
                    "Layer",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "SetCameraCenterY"
                  },
                  "parameters": [
                    "",
                    "=",
                    "DynamicCamera.CurrentY",
                    "Layer",
                    ""
                  ]
                }
              ]
            }
          ],
          "parameters": []
        }
      ],
      "parameters": [
        {
          "description": "The object or group to keep visible on screen",
          "name": "Objects",
          "type": "objectList"
        },
        {
          "description": "The layer whose camera should be moved",
          "name": "Layer",
          "type": "string"
        },
        {
          "description": "Extra space, in pixels, kept around the objects",
          "name": "Padding",
          "type": "expression"
        },
        {
          "description": "Minimum width/height the camera will show, even if the objects are very close together",
          "name": "MinVisibleSize",
          "type": "expression"
        },
        {
          "description": "How fast the camera catches up to its target. Higher is snappier",
          "name": "Smoothing",
          "type": "expression"
        },
        {
          "description": "The camera will never zoom out past this value",
          "name": "MinZoom",
          "type": "expression"
        },
        {
          "description": "The camera will never zoom in past this value",
          "name": "MaxZoom",
          "type": "expression"
        }
      ],
      "objectGroups": []
    }
  ],
