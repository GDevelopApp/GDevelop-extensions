          "type": "expression"
        },
        {
          "description": "Height",
          "name": "Height",
          "type": "expression"
        },
        {
          "description": "Inverse?",
          "longDescription": "When Inverse, it flips from cutting edges to cutting the inside.",
          "name": "Inverse",
          "type": "yesorno"
        }
      ],
