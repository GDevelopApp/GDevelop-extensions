    {
      "description": "Keep an object (background, overlay or decoration) centered on the player. Call this action every frame so the object follows the player across the endless map.",
      "fullName": "Center object on player",
      "functionType": "Action",
      "name": "CenterObjectOnPlayer",
      "sentence": "Center _PARAM1_ on _PARAM0_",
      "events": [
        {
          "aiGeneratedEventId": "01M57FQ5FV30GVYEVGNJSYKQWG",
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetCenter"
              },
              "parameters": [
                "Background",
                "=",
                "Player.CenterX()",
                "=",
                "Player.CenterY()"
              ]
            }
          ]
        }
      ],
      "parameters": [
        {
          "description": "Player",
          "longDescription": "The player object to follow (usually a single instance).",
          "name": "Player",
          "type": "objectList"
        },
        {
          "description": "Object to center",
          "longDescription": "The object kept centered on the player (background, overlay, decoration...).",
          "name": "Background",
          "type": "objectList"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Recycle the map chunks around the player. Call this action every frame (no conditions). Chunks that scroll out of view on one side jump to the opposite side by one full grid, keeping a seamless 3x3 grid centered near the player.",
      "fullName": "Update infinite map",
      "functionType": "Action",
      "name": "UpdateInfiniteMap",
      "sentence": "Center _PARAM1_ chunks around _PARAM0_ (chunk size _PARAM2_ x _PARAM3_)",
      "events": [
        {
          "aiGeneratedEventId": "01M57G64974YK3MHSBN5WMMWSV",
          "type": "BuiltinCommonInstructions::ForEach",
          "object": "Chunk",
          "conditions": [],
          "actions": [],
          "events": [
            {
              "infiniteLoopWarning": false,
              "type": "BuiltinCommonInstructions::While",
              "whileConditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Chunk.X() + ChunkWidth",
                    "<",
                    "Player.CenterX() - ChunkWidth * 1.5"
                  ]
                }
              ],
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetX"
                  },
                  "parameters": [
                    "Chunk",
                    "+",
                    "ChunkWidth * 3"
                  ]
                }
              ]
            },
            {
              "infiniteLoopWarning": false,
              "type": "BuiltinCommonInstructions::While",
              "whileConditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Chunk.X()",
                    ">",
                    "Player.CenterX() + ChunkWidth * 1.5"
                  ]
                }
              ],
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetX"
                  },
                  "parameters": [
                    "Chunk",
                    "-",
                    "ChunkWidth * 3"
                  ]
                }
              ]
            },
            {
              "infiniteLoopWarning": false,
              "type": "BuiltinCommonInstructions::While",
              "whileConditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Chunk.Y() + ChunkHeight",
                    "<",
                    "Player.CenterY() - ChunkHeight * 1.5"
                  ]
                }
              ],
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetY"
                  },
                  "parameters": [
                    "Chunk",
                    "+",
                    "ChunkHeight * 3"
                  ]
                }
              ]
            },
            {
              "infiniteLoopWarning": false,
              "type": "BuiltinCommonInstructions::While",
              "whileConditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Chunk.Y()",
                    ">",
                    "Player.CenterY() + ChunkHeight * 1.5"
                  ]
                }
              ],
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetY"
                  },
                  "parameters": [
                    "Chunk",
                    "-",
                    "ChunkHeight * 3"
                  ]
                }
              ]
            }
          ]
        }
      ],
