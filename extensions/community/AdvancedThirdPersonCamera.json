          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "PlayerVar.Camera.Elevation",
                "+",
                "MousePointerLock::MovementY()*0.1"
              ]
            },
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "PlayerVar.Camera.Rotation",
                "+",
                "MousePointerLock::MovementX()*0.1"
