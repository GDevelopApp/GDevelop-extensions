        {
          "fullName": "Update the layout",
          "functionType": "Action",
          "name": "UpdateLayout",
          "sentence": "Update the layout of _PARAM0_",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "One checkpoint between each section."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "Delete"
                  },
                  "parameters": [
                    "Checkpoint",
                    ""
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "LayoutWidth",
                    "=",
                    "Object.Width()"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "CheckpointCount",
                    "=",
                    "max(1, round(CheckpointCount))"
                  ]
                },
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "Index",
                    "=",
                    "1"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BooleanVariable"
                  },
                  "parameters": [
                    "HasCheckpointModel",
                    "True",
                    ""
                  ]
                }
              ],
              "actions": [],
              "events": [
                {
                  "type": "BuiltinCommonInstructions::Repeat",
                  "repeatExpression": "CheckpointCount - 1",
                  "conditions": [],
                  "actions": [
                    {
                      "type": {
                        "value": "Create"
                      },
                      "parameters": [
                        "",
                        "Checkpoint",
                        "Track.X() + FillLeft + max(1, Track.Width() - FillLeft - FillRight) * Index / CheckpointCount - CheckpointWidth / 2",
                        "Track.Y() + CheckpointY",
                        ""
                      ]
                    },
                    {
                      "type": {
                        "value": "ResizableCapability::ResizableBehavior::SetSize"
                      },
                      "parameters": [
                        "Checkpoint",
                        "Resizable",
                        "CheckpointWidth",
                        "CheckpointHeight"
                      ]
                    },
                    {
                      "type": {
                        "value": "SetNumberObjectVariable"
                      },
                      "parameters": [
                        "Checkpoint",
                        "Index",
