        {
          "fullName": "Update",
          "functionType": "Action",
          "name": "Update",
          "sentence": "Update _PARAM0_",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "LayoutWidth",
                    "!=",
                    "Object.Width()"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "GoalProgressBar::GoalProgressBar::UpdateLayout"
                  },
                  "parameters": [
                    "Object",
                    ""
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "Smoothing",
                    "<=",
                    "0"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "ShownRatio",
                    "=",
                    "clamp(Value / max(0.0001, MaxValue), 0, 1)"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "Smoothing",
                    ">",
                    "0"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "ShownRatio",
                    "+",
                    "(clamp(Value / max(0.0001, MaxValue), 0, 1) - ShownRatio) * min(1, Smoothing * TimeDelta())"
                  ]
                }
              ]
