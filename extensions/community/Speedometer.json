        {
          "fullName": "Update",
          "functionType": "Action",
          "name": "Update",
          "sentence": "Update _PARAM0_",
          "events": [
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "Smoothing",
                    "<=",
                    "0"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "ShownValue",
                    "=",
                    "clamp(Value, 0, MaxValue)"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "Smoothing",
                    ">",
                    "0"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "SetNumberVariable"
                  },
                  "parameters": [
                    "ShownValue",
                    "+",
                    "(clamp(Value, 0, MaxValue) - ShownValue) * min(1, Smoothing * TimeDelta())"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [],
              "actions": [
                {
                  "type": {
                    "value": "SetAngle"
                  },
                  "parameters": [
                    "Needle",
                    "=",
                    "MinAngle + (MaxAngle - MinAngle) * ShownValue / max(0.0001, MaxValue)"
                  ]
                },
                {
                  "type": {
                    "value": "TextContainerCapability::TextContainerBehavior::SetValue"
                  },
                  "parameters": [
                    "ValueText",
                    "Text",
                    "=",
                    "ToString(roundTo(ShownValue, Decimals))"
                  ]
                },
                {
                  "type": {
                    "value": "ResizableCapability::ResizableBehavior::SetWidth"
                  },
                  "parameters": [
                    "Bar",
                    "Resizable",
                    "=",
                    "BarFullWidth * ShownValue / max(0.0001, MaxValue)"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "NumberVariable"
                  },
                  "parameters": [
                    "BarSegmentCount",
                    ">",
                    "0"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "ResizableCapability::ResizableBehavior::SetWidth"
                  },
                  "parameters": [
                    "Bar",
                    "Resizable",
                    "=",
                    "BarFullWidth * ceil(BarSegmentCount * ShownValue / max(0.0001, MaxValue) - 0.01) / BarSegmentCount"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Comment",
              "color": {
                "b": 109,
                "g": 230,
                "r": 255,
                "textB": 0,
                "textG": 0,
                "textR": 0
              },
              "comment": "An empty bar is hidden (a tiled sprite can not be 0 pixel wide)."
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Bar.Width()",
                    "<",
                    "1"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "Hide"
                  },
                  "parameters": [
                    "Bar"
                  ]
                }
              ]
            },
            {
              "type": "BuiltinCommonInstructions::Standard",
              "conditions": [
                {
                  "type": {
                    "value": "BuiltinCommonInstructions::CompareNumbers"
                  },
                  "parameters": [
                    "Bar.Width()",
                    ">=",
                    "1"
                  ]
                }
              ],
              "actions": [
                {
                  "type": {
                    "value": "Show"
                  },
                  "parameters": [
                    "Bar"
                  ]
                }
              ]
            }
